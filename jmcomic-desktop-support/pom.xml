<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.jukomu</groupId>
        <artifactId>jmcomic-api-java</artifactId>
        <version>1.1.7</version>
    </parent>

    <artifactId>jmcomic-desktop-support</artifactId>
    <packaging>jar</packaging>

    <name>jmcomic-desktop-support</name>
    <description>macOS desktop (Swing) app for JMComic API for Java.</description>
    <url>https://github.com/JUKOMU/JMComic-Api-Java</url>

    <dependencies>
        <dependency>
            <groupId>io.github.jukomu</groupId>
            <artifactId>jmcomic-core</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <!--
                  org.sejda.imageio:webp-imageio 只带 Mac x86_64 的 .dylib，
                  在 Apple Silicon 上 ImageIO.read 会抛 UnsatisfiedLinkError，
                  导致所有图片（阅读器和下载）全部失败。换成带 Mac aarch64 的分支。
                  两者的类名同为 com.luciad.imageio.webp.*，必须排除后再引入。
                -->
                <exclusion>
                    <groupId>org.sejda.imageio</groupId>
                    <artifactId>webp-imageio</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.github.usefulness</groupId>
            <artifactId>webp-imageio</artifactId>
            <version>0.10.0</version>
        </dependency>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.7.2</version>
        </dependency>
        <!-- 桌面端需要能看到 core 的告警，否则失败原因全部被吞掉 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.jukomu.jmcomic.desktop.JmDesktopApp</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
